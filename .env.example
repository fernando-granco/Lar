# Copy to .env and adjust. Everything is optional.

# Your timezone, so "today" and due dates line up with your household.
TZ=America/New_York

# Optional agent key. Use at least 32 random characters. When set, MCP requests and any API request that identifies
# as an agent (X-Lar-Agent) must send it as
#   Authorization: Bearer <key>   or   X-Api-Key: <key>
# It does not protect the browser app.
LAR_API_KEY=

# Optional: sign people in automatically through Cloudflare Access.
# Team is the part before .cloudflareaccess.com; AUD is the application's Audience tag.
# Each person's email must be set on their profile in the Household page.
LAR_CF_ACCESS_TEAM=
LAR_CF_ACCESS_AUD=
