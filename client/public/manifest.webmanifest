{
  "name": "Lar",
  "short_name": "Lar",
  "description": "The family's home hub: shared to-dos, shopping lists, projects, recipes, and weekly plans.",
  "id": "/",
  "start_url": "/today",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "lang": "en",
  "categories": ["productivity", "lifestyle"],
  "prefer_related_applications": false,
  "background_color": "#f8f7f3",
  "theme_color": "#345a51",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "To-dos", "short_name": "To-dos", "url": "/todos", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Shopping", "short_name": "Shopping", "url": "/shopping", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Projects", "short_name": "Projects", "url": "/projects", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] }
  ]
}
